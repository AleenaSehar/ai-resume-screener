GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of origins allowed to call this API (no trailing slashes).
# Include your deployed Netlify URL in production.
ALLOWED_ORIGINS=http://localhost:3000

# Postgres connection string for screening history storage (optional - /screen and
# core features work fine without it; history endpoints degrade gracefully).
# Use Neon's POOLED connection string (hostname ends in -pooler) to avoid connection
# exhaustion across serverless invocations. Free tier, no card: neon.tech.
# Run backend/schema.sql once in Neon's SQL editor before setting this.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign/verify login sessions (JWT). Required only if you want
# email+password accounts - without it, /auth/signup and /auth/login return a
# clean 503 and the rest of the app (anonymous screening + anonymous_id
# history) keeps working exactly as before. Auth also requires DATABASE_URL
# above (no database, no users table, no accounts) - set both or neither.
# Generate a real secret (32+ bytes - PyJWT warns on anything shorter):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
